{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PVE Desktop",
  "version": "1.0.1",
  "identifier": "dev.pveclient.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PVE 云桌面",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* ws://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "Proxmox VE 云桌面客户端",
    "longDescription": "登录 Proxmox VE 后快速连接你有权限的虚拟机；优先使用 SPICE 获得桌面级体验，未启用时自动降级为内嵌网页控制台。"
  }
}
